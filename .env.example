####################################################################################################
# Core Banking Platform — environment template
#
#   cp .env.example .env      then fill in the values below.
#
# docker-compose reads .env from this directory automatically. `.env` is gitignored and must never
# be committed — this file (.env.example) is the committed template and holds no real secrets.
#
# Every variable is prefixed CBP_ so this project's settings cannot collide with another project's
# on the same machine. The prefix is part of the name the services read, not just a label here.
#
# Every value has a safe default in the service's application.yml, so an unset variable degrades to
# "feature off" rather than to a weak default.
####################################################################################################

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------
# One PostgreSQL instance; each service owns a private schema inside the same database.
CBP_POSTGRES_DB=banking
CBP_POSTGRES_USER=banking
# CHANGE ME. Local-only credential; production reads this from Vault/KMS, not from a file.
CBP_POSTGRES_PASSWORD=banking

# ---------------------------------------------------------------------------------------------
# Service-to-service authentication (ADR-008)
# ---------------------------------------------------------------------------------------------
# Internal calls carry a short-lived JWT:
#   account/card/interest-fee/payment -> ledger-service
#   payment                           -> risk-aml-service
# Off by default, so the platform still starts with no secret configured.
#
# CBP_SERVICE_AUTH_SECRET must be at least 32 bytes — a shorter value is refused at startup rather
# than silently weakening the signature. Generate one with:
#
#   openssl rand -base64 48
#
# NOTE: this is a shared HMAC secret, so every holder can mint as well as verify. Adequate for local
# and CI use. Production should move to RS256 + JWKS (see ADR-008, "Still not done").
CBP_SERVICE_AUTH_ENABLED=false
CBP_SERVICE_AUTH_SECRET=SH6zWexQFJEsz1B9YL2sFrVuBUIb-JYW1PCg8w62p3M9LAStasmh55nIcRAgiqxqpWT0GjKdyGB5Y4Sb7zOIJg==
CBP_SERVICE_AUTH_ISSUER=core-banking-platform
# Token lifetime and the drift tolerated between service clocks, in seconds.
CBP_SERVICE_AUTH_TOKEN_TTL=60
CBP_SERVICE_AUTH_CLOCK_SKEW=30
# Leave unset. Each service defaults correctly: receivers (ledger, risk-aml) require inbound
# identity, callers do not. Set false on a receiver only to troubleshoot.
# CBP_SERVICE_AUTH_REQUIRE_INBOUND=

# ---------------------------------------------------------------------------------------------
# Edge authentication (api-gateway)
# ---------------------------------------------------------------------------------------------
# With this false the gateway permits all requests, which is why it is only ever a local setting.
# Turn it on and point the gateway at the bank IdP before any shared environment.
CBP_GATEWAY_SECURITY_ENABLED=false
# The IdP issuer URI. Spring reads this under its own name, so docker-compose maps
# CBP_GATEWAY_JWT_ISSUER_URI onto SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI for the
# gateway container — set it here, not under the Spring name.
CBP_GATEWAY_JWT_ISSUER_URI=
# Requests per client per minute at the gateway.
CBP_GATEWAY_RATE_LIMIT=120

# ---------------------------------------------------------------------------------------------
# Event backbone — Kafka (ADR-005)
# ---------------------------------------------------------------------------------------------
# With this false the outbox relay logs instead of publishing, and notification-service registers
# no listener — the platform runs without a broker. Set true once the kafka service is up.
CBP_KAFKA_ENABLED=false
# Reached over the compose network; use localhost:9092 when running a service outside compose.
CBP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CBP_KAFKA_TOPIC_PAYMENT_EVENTS=payment.events
# Declared by kafka-init so the estate topic set is explicit; no producer or consumer yet.
CBP_KAFKA_TOPIC_ACCOUNT_EVENTS=account.events
CBP_KAFKA_TOPIC_CARD_EVENTS=card.events
CBP_KAFKA_TOPIC_CUSTOMER_EVENTS=customer.events
CBP_KAFKA_CONSUMER_GROUP=notification-service
# How long the relay waits for the broker to acknowledge before leaving the row PENDING to retry.
CBP_KAFKA_SEND_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------------------------
# Inter-service wiring
# ---------------------------------------------------------------------------------------------
# account-service -> ledger-service posting transport: "off" or "grpc" (ADR-007).
CBP_LEDGER_POSTING=grpc
# GL account credited when a customer account is debited.
CBP_LEDGER_SETTLEMENT_ACCOUNT=SETTLEMENT
# payment-service screening: "stub" or "risk-service".
CBP_SCREENING_ADAPTER=risk-service
# AML: amount at or above which a transaction is held for review.
CBP_AML_LARGE_AMOUNT_THRESHOLD=10000

# ---------------------------------------------------------------------------------------------
# Scheduled batches
# ---------------------------------------------------------------------------------------------
# Both batches are OFF by default so a local or CI run never fires one unexpectedly. Each also has
# an API endpoint that runs the same work on demand. Turn them on per environment.
#   end-of-day interest accrual & capitalisation (interest-fee-service)
CBP_EOD_SCHEDULER_ENABLED=false
CBP_EOD_SCHEDULER_CRON=0 0 23 * * *
#   standing-order execution (payment-service)
CBP_STANDING_ORDERS_SCHEDULER_ENABLED=false
CBP_STANDING_ORDERS_SCHEDULER_CRON=0 30 0 * * *

# How often the transactional outbox relay polls for unpublished events, in milliseconds.
CBP_OUTBOX_RELAY_DELAY_MS=5000
