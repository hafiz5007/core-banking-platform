<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.bank</groupId>
    <artifactId>banking-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Core Banking Platform :: Parent</name>
    <description>Foundations for the Core Banking &amp; Payment System.</description>

    <modules>
        <module>common-lib</module>
        <module>ledger-grpc-api</module>
        <module>account-service</module>
        <module>customer-service</module>
        <module>ledger-service</module>
        <module>payment-service</module>
        <module>interest-fee-service</module>
        <module>card-service</module>
        <module>notification-service</module>
        <module>risk-aml-service</module>
        <module>admin-service</module>
        <module>reporting-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.7.0</springdoc.version>
        <!-- 1.21+ bundles a docker-java that negotiates a Docker Engine 29 compatible API version;
             1.20.x fails client-side with HTTP 400 against modern Docker Desktop. -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <spotless.version>2.43.0</spotless.version>
        <!--
          Docker Engine API version Testcontainers negotiates (docker-java reads the `api.version`
          system property; there is no env-var equivalent). Docker Engine 29 dropped support for
          API < 1.40, and the docker-java default is older, so the handshake fails with an
          unhelpful HTTP 400. Pinning 1.41 (Docker 20.10+) works across every supported engine.
          Override with -Ddocker.api.version=... if your daemon needs something else.
        -->
        <docker.api.version>1.41</docker.api.version>
        <!-- gRPC bridge (account-service → ledger-service). grpc 1.68.x is built against the
             protobuf 3.25.x that the Spring Boot BOM already manages, so the two stay aligned. -->
        <grpc.version>1.68.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <!-- Service-to-service JWTs (ADR-008); not managed by the Spring Boot BOM. -->
        <nimbus-jose-jwt.version>9.47</nimbus-jose-jwt.version>
        <!-- Kafka event backbone (ADR-005). Broker image is apache/kafka in KRaft mode. -->
        <kafka.image>apache/kafka:3.7.2</kafka.image>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>common-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>ledger-grpc-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <api.version>${docker.api.version}</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <api.version>${docker.api.version}</api.version>
                        </systemPropertyVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              Bind failsafe in every module. The pluginManagement entry above only configures the
              plugin; without this declaration nothing runs the integration-test/verify goals and
              the *IT tests are compiled but silently skipped.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Opt-in quality gate: `mvn verify -Pquality`.
          Kept out of the default build so day-to-day builds are fast and never blocked on
          formatting. CI runs this profile. Enforces code formatting (Spotless / Google Java Format)
          and produces a JaCoCo coverage report with a lenient floor.
        -->
        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <version>${spotless.version}</version>
                        <configuration>
                            <java>
                                <googleJavaFormat/>
                                <removeUnusedImports/>
                                <trimTrailingWhitespace/>
                                <endWithNewline/>
                            </java>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>coverage-floor</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>INSTRUCTION</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.40</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
