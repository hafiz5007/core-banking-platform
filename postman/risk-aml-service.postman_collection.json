{
  "info" : {
    "description" : "Transaction monitoring and AML case handling. payment-service calls /evaluate on the payment hot path, so this service requires a service token when auth is on. Generated from the service's controllers. Set {{baseUrl}} to the gateway (http://localhost:8080) to go through the edge instead of hitting the service directly. Authorization is disabled by default: enable it and set {{accessToken}} once gateway.security.enabled=true.",
    "name" : "Core Banking — risk-aml-service",
    "schema" : "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item" : [
    {
      "event" : [
        {
          "listen" : "test",
          "script" : {
            "exec" : [
              "pm.test(\"2xx\", () => pm.expect(pm.response.code).to.be.below(300));"
            ],
            "type" : "text/javascript"
          }
        }
      ],
      "name" : "Evaluate — allowed",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"accountRef\" : \"DEP-001\",\n  \"amount\" : \"100.00\",\n  \"counterpartyCountry\" : \"GB\",\n  \"currencyCode\" : \"USD\",\n  \"transactionRef\" : \"TXN-{{$guid}}\"\n}\n"
        },
        "description" : "Below the threshold and a low-risk country: ALLOW with no case.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "risk",
            "evaluate"
          ],
          "raw" : "{{baseUrl}}/api/v1/risk/evaluate"
        }
      }
    },
    {
      "event" : [
        {
          "listen" : "test",
          "script" : {
            "exec" : [
              "const ok = pm.response.code < 300;",
              "pm.test(\"2xx\", () => pm.expect(ok).to.be.true);",
              "if (ok) { pm.collectionVariables.set(\"caseId\", pm.response.json().caseId); }"
            ],
            "type" : "text/javascript"
          }
        }
      ],
      "name" : "Evaluate — large amount (HOLD)",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"accountRef\" : \"DEP-001\",\n  \"amount\" : \"25000.00\",\n  \"counterpartyCountry\" : \"GB\",\n  \"currencyCode\" : \"USD\",\n  \"transactionRef\" : \"TXN-{{$guid}}\"\n}\n"
        },
        "description" : "At or above the large-amount threshold (default 10000): HOLD, opens a case.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "risk",
            "evaluate"
          ],
          "raw" : "{{baseUrl}}/api/v1/risk/evaluate"
        }
      }
    },
    {
      "name" : "Evaluate — possible structuring",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"accountRef\" : \"DEP-001\",\n  \"amount\" : \"9500.00\",\n  \"counterpartyCountry\" : \"GB\",\n  \"currencyCode\" : \"USD\",\n  \"transactionRef\" : \"TXN-{{$guid}}\"\n}\n"
        },
        "description" : "Between 90% and 100% of the threshold: ALLOW but flagged POSSIBLE_STRUCTURING.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "risk",
            "evaluate"
          ],
          "raw" : "{{baseUrl}}/api/v1/risk/evaluate"
        }
      }
    },
    {
      "name" : "Evaluate — high-risk country",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"accountRef\" : \"DEP-001\",\n  \"amount\" : \"10.00\",\n  \"counterpartyCountry\" : \"XA\",\n  \"currencyCode\" : \"USD\",\n  \"transactionRef\" : \"TXN-{{$guid}}\"\n}\n"
        },
        "description" : "XA/XB/XC are the demo high-risk list: HOLD regardless of amount.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "risk",
            "evaluate"
          ],
          "raw" : "{{baseUrl}}/api/v1/risk/evaluate"
        }
      }
    },
    {
      "event" : [
        {
          "listen" : "test",
          "script" : {
            "exec" : [
              "pm.test(\"2xx\", () => pm.expect(pm.response.code).to.be.below(300));"
            ],
            "type" : "text/javascript"
          }
        }
      ],
      "name" : "Get case",
      "request" : {
        "description" : "",
        "header" : [
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "GET",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "risk",
            "cases",
            "{{caseId}}"
          ],
          "raw" : "{{baseUrl}}/api/v1/risk/cases/{{caseId}}"
        }
      }
    },
    {
      "name" : "Close case (file SAR)",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"fileSar\" : true,\n  \"resolution\" : \"Reviewed: legitimate property purchase\"\n}\n"
        },
        "description" : "A case can only be closed once.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "risk",
            "cases",
            "{{caseId}}",
            "close"
          ],
          "raw" : "{{baseUrl}}/api/v1/risk/cases/{{caseId}}/close"
        }
      }
    }
  ],
  "variable" : [
    {
      "key" : "baseUrl",
      "value" : "http://localhost:8088"
    },
    {
      "key" : "organizationId",
      "value" : "DEFAULT"
    },
    {
      "key" : "accessToken",
      "value" : ""
    },
    {
      "key" : "caseId",
      "value" : ""
    }
  ]
}
