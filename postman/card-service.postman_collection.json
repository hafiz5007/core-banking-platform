{
  "info" : {
    "description" : "Card issuance, controls, authorizations, settlement and reconciliation. Generated from the service's controllers. Set {{baseUrl}} to the gateway (http://localhost:8080) to go through the edge instead of hitting the service directly. Authorization is disabled by default: enable it and set {{accessToken}} once gateway.security.enabled=true.",
    "name" : "Core Banking — card-service",
    "schema" : "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item" : [
    {
      "event" : [
        {
          "listen" : "test",
          "script" : {
            "exec" : [
              "const ok = pm.response.code < 300;",
              "pm.test(\"2xx\", () => pm.expect(ok).to.be.true);",
              "if (ok) { pm.collectionVariables.set(\"cardId\", pm.response.json().id); }"
            ],
            "type" : "text/javascript"
          }
        }
      ],
      "name" : "Issue card",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"accountCode\" : \"DEP-001\",\n  \"currencyCode\" : \"USD\",\n  \"openingAvailable\" : \"1000.00\"\n}\n"
        },
        "description" : "Returns a tokenised card; the PAN is never stored.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "cards"
          ],
          "raw" : "{{baseUrl}}/api/v1/cards"
        }
      }
    },
    {
      "event" : [
        {
          "listen" : "test",
          "script" : {
            "exec" : [
              "pm.test(\"2xx\", () => pm.expect(pm.response.code).to.be.below(300));"
            ],
            "type" : "text/javascript"
          }
        }
      ],
      "name" : "Get card",
      "request" : {
        "description" : "",
        "header" : [
          {
            "key" : "X-Correlation-Id",
