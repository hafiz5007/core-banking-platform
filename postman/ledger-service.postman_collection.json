              "language" : "json"
            }
          },
          "raw" : "{\n  \"accountType\" : \"ASSET\",\n  \"code\" : \"{{creditAccount}}\",\n  \"currencyCode\" : \"USD\",\n  \"name\" : \"Settlement\"\n}\n"
        },
        "description" : "",
