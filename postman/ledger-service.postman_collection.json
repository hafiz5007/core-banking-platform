      }
    },
    {
      "event" : [
        {
          "listen" : "test",
          "script" : {
            "exec" : [
              "const ok = pm.response.code < 300;",
              "pm.test(\"2xx\", () => pm.expect(ok).to.be.true);",
              "if (ok) { pm.collectionVariables.set(\"entryId\", pm.response.json().id); }"
            ],
            "type" : "text/javascript"
          }
        }
      ],
      "name" : "Post journal entry",
      "request" : {
        "body" : {
          "mode" : "raw",
          "options" : {
            "raw" : {
              "language" : "json"
            }
          },
          "raw" : "{\n  \"idempotencyKey\" : \"entry-{{$guid}}\",\n  \"lines\" : [\n    {\n      \"accountCode\" : \"{{debitAccount}}\",\n      \"amount\" : \"125.00\",\n      \"direction\" : \"DEBIT\"\n    },\n    {\n      \"accountCode\" : \"{{creditAccount}}\",\n      \"amount\" : \"125.00\",\n      \"direction\" : \"CREDIT\"\n    }\n  ],\n  \"narrative\" : \"Manual posting\",\n  \"valueDate\" : \"2026-01-15\"\n}\n"
        },
        "description" : "Must balance: debits equal credits, at least two lines, one currency. Replaying the same idempotencyKey returns the original entry.",
        "header" : [
          {
            "key" : "Content-Type",
            "value" : "application/json"
          },
          {
            "key" : "X-Correlation-Id",
            "value" : "postman-{{$guid}}"
          },
          {
            "key" : "X-Organization-Id",
            "value" : "{{organizationId}}"
          },
          {
            "disabled" : true,
            "key" : "Authorization",
            "value" : "Bearer {{accessToken}}"
          }
        ],
        "method" : "POST",
        "url" : {
          "host" : [
            "{{baseUrl}}"
          ],
          "path" : [
            "api",
            "v1",
            "ledger",
            "entries"
          ],
          "raw" : "{{baseUrl}}/api/v1/ledger/entries"
        }
      }
    },
